# Independent Guido runtime
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/guido
DATABASE_POOL_SIZE=8
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_BASE_URL=http://localhost:3000
AUTH_COOKIE_NAME=guido_session

# Optional Google OAuth. Email/password works without these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email. Without SMTP, messages are written to this local outbox.
EMAIL_FROM=Guido <no-reply@localhost>
LOCAL_EMAIL_OUTBOX_DIR=.local/email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Local filesystem storage. Adapter can later target S3-compatible storage.
LOCAL_STORAGE_DIR=.local/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
STORAGE_SIGNING_SECRET=
